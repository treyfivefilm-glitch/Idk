# Nothing here is required to run the app — it works out of the box on
# mock data and localStorage. Fill these in only as you wire up the real
# services described in README.md.

# --- Supabase (optional swap-in for the localStorage collection store) ---
# Exposed to client code, so these must use the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Comic Vine (catalog/identification search, live — see api/comics/search.ts) ---
# Secret — read server-side only via api/_lib/comicvine.ts, never client-exposed.
COMICVINE_API_KEY=

# --- GoCollect (only once src/services/value.ts fetchValue's graded sold-sales side is made live) ---
# Secret — keep it server-side / in an edge function, not in a client-exposed VITE_ var.
GOCOLLECT_API_KEY=

# --- eBay Browse API (only once fetchValue's raw asking-price side is made live) ---
# These are secrets — keep them server-side / in an edge function, not in
# client-exposed VITE_ vars.
EBAY_APP_ID=
EBAY_CERT_ID=

# --- Cover recognition (only once src/services/recognition.ts identifyByImage is made live) ---
RECOGNITION_API_KEY=

# --- RevenueCat (only once src/services/billing.ts is made live) ---
REVENUECAT_PUBLIC_API_KEY=
